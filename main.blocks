<xml xmlns="https://developers.google.com/blockly/xml"><variables></variables><block type="pxt-on-start" id="}cl)O2[3[={?a3{za_n`" x="0" y="0"><statement name="HANDLER"><block type="typescript_statement" id="eZrVk.?u$qaw8h~wihQ/"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="namespace pxtArrayUtils {" line1="" line2="    //% block=&quot;%array から最大値を調べる&quot;" line3="    export function max (array: number[]): number {" line4="        if (array.length == 0) {" line5="            return 0" line6="        }" line7="        let tmp = array[0]" line8="        for (let v of array) {" line9="            if (v &gt; tmp) {" line10="                tmp = v" line11="            }" line12="        }" line13="        return tmp" line14="    }" line15="}" numlines="16"></mutation></block></statement></block></xml>